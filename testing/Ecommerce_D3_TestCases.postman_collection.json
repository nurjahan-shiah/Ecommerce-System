        ],
        "body": { "mode": "raw", "raw": "{\n  \"auctionId\": 6,\n  \"expeditedShipping\": false,\n  \"cardNumber\": \"4111111111111111\",\n  \"cardName\": \"Winner User\",\n  \"expiryDate\": \"12/27\",\n  \"securityCode\": \"123\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/payments/pay", "host": ["{{baseUrl}}"], "path": ["api","payments","pay"] }

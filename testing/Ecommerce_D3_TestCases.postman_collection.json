        ],
        "body": { "mode": "raw", "raw": "{\"auctionId\": 5}" },
        "url": { "raw": "{{baseUrl}}/api/payments/pay", "host": ["{{baseUrl}}"], "path": ["api","payments","pay"] }
      }
    },

    {
      "name": "TC17 — AI Health Check (UC8 Gemini)",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
          "pm.test('AI service running message', () => pm.expect(pm.response.text()).to.include('Gemini'));"
        ], "type": "text/javascript" }
      }],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/ai/health", "host": ["{{baseUrl}}"], "path": ["api","ai","health"] }
      }
    },

    {
      "name": "TC18 — Browse All Active Auctions (UC2)",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
          "const j = pm.response.json();",
          "pm.test('returns array', () => pm.expect(j).to.be.an('array'));",
          "pm.test('items have required fields', () => {",
          "  if(j.length > 0) {",
          "    pm.expect(j[0].auctionId).to.exist;",
          "    pm.expect(j[0].itemName).to.be.a('string');",
          "    pm.expect(j[0].currentPrice).to.be.a('number');",
          "    pm.expect(j[0].status).to.eql('ACTIVE');",
          "  }",
          "});"
        ], "type": "text/javascript" }
      }],
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/catalogue/items/active", "host": ["{{baseUrl}}"], "path": ["api","catalogue","items","active"] }
      }
    },

    {
      "name": "TC19 — Duplicate Payment Rejected (UC5 Security)",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "pm.test('Status 400 — duplicate payment rejected', () => pm.response.to.have.status(400));",
          "const j = pm.response.json();",
          "pm.test('error explains already paid', () => pm.expect(j.error).to.be.a('string'));"
        ], "type": "text/javascript" }
      }],
      "request": {
        "method": "POST",
        "header": [
          {"key":"Content-Type","value":"application/json"},
          {"key":"X-Session-Id","value":"{{winnerSession}}"},
